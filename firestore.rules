rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // User deletion disabled via Firestore
    }
    
    // Feedbacks Collection
    match /feedbacks/{feedbackId} {
      // Any authenticated Student or Company user can read feedback
      allow read: if request.auth != null;
      
      // Authenticated users can create feedback if they set submittedBy to their own UID
      allow create: if request.auth != null && request.resource.data.submittedBy == request.auth.uid;
      
      // Users can ONLY update or delete their own feedback
      allow update: if request.auth != null && resource.data.submittedBy == request.auth.uid;
      allow delete: if request.auth != null && resource.data.submittedBy == request.auth.uid;
    }
  }
}
